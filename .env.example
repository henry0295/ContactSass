APP_NAME=ContactSass
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.contactsass.com

LOG_CHANNEL=stack
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=postgres.default.svc.cluster.local
DB_PORT=5432
DB_DATABASE=contactsass
DB_USERNAME=contactsass
DB_PASSWORD=
DB_SSLMODE=require

REDIS_HOST=redis.default.svc.cluster.local
REDIS_PASSWORD=
REDIS_PORT=6379

CACHE_DRIVER=redis
SESSION_DRIVER=cookie
QUEUE_CONNECTION=redis
BROADCAST_DRIVER=log

QUEUE_BATCH_SIZE=1000

# Amazon Web Services
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
SES_DEFAULT_FROM=noreply@contactsass.com
SES_SNS_TOPIC_ARN=arn:aws:sns:us-east-1:ACCOUNT_ID:ses-events
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:ACCOUNT_ID:sms-events
RATE_LIMIT_EMAILS=1000
RATE_LIMIT_SMS=600
RATE_LIMIT_CALLS=120

# FreeSWITCH Configuration
FREESWITCH_HOST=freeswitch.default.svc.cluster.local
FREESWITCH_PORT=8021
FREESWITCH_PASSWORD=ClueCon

# Sanctum Token Configuration
SANCTUM_STATEFUL_DOMAINS=contactsass.com,api.contactsass.com
SANCTUM_GUARD=sanctum
SESSION_DOMAIN=.contactsass.com

# Mail Configuration (backup)
MAIL_MAILER=ses
MAIL_FROM_ADDRESS=noreply@contactsass.com
MAIL_FROM_NAME="ContactSass"

# Stripe Billing (Future)
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Observability
SENTRY_DSN=
DATADOG_API_KEY=
OTEL_ENABLED=false

# Frontend URL
FRONTEND_URL=https://app.contactsass.com
VERIFY_WEBHOOK_SIGNATURE=true
