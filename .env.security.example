# ============================================================================
# SECURITY CONFIGURATION (.env.example)
# ============================================================================
# Copy this to .env and fill in your actual values.
# NEVER commit .env to version control!
# ============================================================================

# Application
APP_NAME="ContactSass"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://api.example.com
APP_KEY=base64:your-app-key-here
APP_HTTPS_ENFORCED=true

# Database
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=contactsass
DB_USERNAME=root
DB_PASSWORD=your-strong-password

# ============================================================================
# AWS Configuration
# ============================================================================
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_DEFAULT_REGION=us-east-1
AWS_REGION=us-east-1

# AWS Secrets Manager Integration
AWS_SECRETS_ENABLED=true
AWS_SECRETS_CACHE_TTL=3600
AWS_SECRETS_DB_PASSWORD=contact-sass/database/password
AWS_SECRETS_DB_ROOT_PASSWORD=contact-sass/database/root-password
AWS_SECRETS_AWS_KEY_ID=contact-sass/aws/access-key-id
AWS_SECRETS_AWS_SECRET_KEY=contact-sass/aws/secret-access-key

# AWS SES Integration
AWS_SES_REGION=us-east-1
AWS_SECRETS_SES_KEY=contact-sass/integrations/amazon-ses/key
AWS_SECRETS_SES_SECRET=contact-sass/integrations/amazon-ses/secret

# AWS SNS Integration
AWS_SECRETS_SNS_KEY=contact-sass/integrations/amazon-sns/key
AWS_SECRETS_SNS_SECRET=contact-sass/integrations/amazon-sns/secret

# ============================================================================
# Security: CSRF Protection
# ============================================================================
CSRF_PROTECTION_ENABLED=true
CSRF_TOKEN_NAME=X-CSRF-Token
CSRF_HEADER_NAME=X-CSRF-Token

# ============================================================================
# Security: Webhook Signature Verification
# ============================================================================
WEBHOOK_VERIFICATION_ENABLED=true

# Webhook Secrets (from AWS Secrets Manager in production)
WEBHOOK_AMAZON_SES_SECRET=your-webhook-signature-secret
WEBHOOK_AMAZON_SNS_SECRET=your-webhook-signature-secret
WEBHOOK_FREESWITCH_SECRET=your-webhook-signature-secret

# ============================================================================
# Security: HTTPS/HSTS Enforcement
# ============================================================================
HTTPS_REDIRECT_ENABLED=true
HTTPS_HSTS_MAX_AGE=31536000
HTTPS_HSTS_INCLUDE_SUBDOMAINS=true
HTTPS_HSTS_PRELOAD=true

# ============================================================================
# Security: Audit Logging
# ============================================================================
SECURITY_AUDIT_ENABLED=true
SECURITY_AUDIT_RETENTION_DAYS=90
SECURITY_AUDIT_ALERTS_ENABLED=true
SECURITY_AUDIT_ALERT_CHANNEL=mail
SECURITY_ALERT_RECIPIENTS=security@example.com

# ============================================================================
# Security: Password Policy
# ============================================================================
PASSWORD_MIN_LENGTH=12
PASSWORD_EXPIRY_DAYS=90
PASSWORD_WARNING_DAYS=14

# ============================================================================
# Security: Rate Limiting
# ============================================================================
RATE_LIMIT_LOGIN=5/15
RATE_LIMIT_PASSWORD_RESET=3/60
RATE_LIMIT_API_KEY=10/60
RATE_LIMIT_WEBHOOK=1000/60
RATE_LIMIT_DEFAULT=1000/60

# ============================================================================
# Security: IP Whitelisting (Optional)
# ============================================================================
IP_WHITELIST_ENABLED=false
IP_WHITELIST_MODE=allow
IP_WHITELIST_IPS=

# ============================================================================
# Security: Session Configuration
# ============================================================================
SESSION_DRIVER=cookie
SESSION_SECURE_COOKIES=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_TIMEOUT_MINUTES=30
SESSION_IDLE_TIMEOUT_MINUTES=15

# ============================================================================
# Redis (for rate limiting and caching)
# ============================================================================
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

# ============================================================================
# Logging
# ============================================================================
LOG_CHANNEL=stack
LOG_LEVEL=debug

# ============================================================================
# Email Configuration (for alerts)
# ============================================================================
MAIL_DRIVER=ses
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="ContactSass"

# ============================================================================
# Third-party Integrations
# ============================================================================

# FreeSWITCH
FREESWITCH_HOST=freeswitch.example.com
FREESWITCH_ESL_PORT=8021
FREESWITCH_ESL_PASSWORD=your-freeswitch-password

# ============================================================================
# CORS Configuration
# ============================================================================
CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With,X-Tenant-ID

# ============================================================================
# JWT/Sanctum Authentication
# ============================================================================
JWT_SECRET=your-jwt-secret-key
SANCTUM_STATEFUL_DOMAINS=app.example.com,api.example.com

# ============================================================================
# Content Security Policy (CSP)
# ============================================================================
CSP_ENABLED=true
CSP_REPORT_ONLY=false
CSP_POLICY="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:;"

# ============================================================================
# IMPORTANT SECURITY NOTES
# ============================================================================
# 1. NEVER commit this file to version control
# 2. Use AWS Secrets Manager for production secrets
# 3. Rotate all secrets regularly
# 4. Use strong, unique passwords (min 32 characters)
# 5. Enable HTTPS/TLS in production
# 6. Configure HSTS headers
# 7. Enable security audit logging
# 8. Monitor security audit logs regularly
# 9. Keep dependencies updated
# 10. Run regular security audits
